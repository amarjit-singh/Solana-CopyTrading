# Example .env for Solana trading bot
# Copy this to a file named .env and replace values marked with <REPLACE_ME>

# RPC / gRPC endpoints
GRPCTOKEN=
GRPC_ENDPOINT=https://grpc.ny.shyft.to/
RPC_URL=https://rpc.shyft.to?api_key=<REPLACE_ME>

# Wallet / keys
ENCODED_PRIVATE_KEY=<REPLACE_ME>    # base58 or base64 encoded private key (DO NOT commit)
PUB_KEY=<REPLACE_ME>                # public key (base58)
COPY_WALLET=<REPLACE_ME>            # REQUIRED: wallet pubkey to copy trades from
COPY_WALLET_2=                      # optional: second wallet pubkey to copy trades from

# Telegram (optional, used for bot notifications)
TELEGRAM_BOT_TOKEN=<REPLACE_ME>
TELEGRAM_CHAT_ID=<REPLACE_ME>

# Swap method - choose one of: 0slot, nozomi, race, solana
SWAP_METHOD=0slot
ENABLE_SWAP_TIP=true

# External services (tips / endpoints)
NOZOMI_URL=http://ams1.nozomi.temporal.xyz/
NOZOMI_UUID=4516a74a-ad06-4faf-9de4-10cce6e37f6b
NEXT_BLOCK_URL=https://ny.nextblock.io/api/v2/submit
NEXTBLOCK_API_KEY=trial1752153681-wTJSpE5Nz%2BMy0lWqP8eW63o9OEVd9xOMZQrzf3gHJt8%3D
ZEROSLOT_RPC_URL=http://ny1.0slot.trade/?api-key=ca6fc089f334462e90d47012d2a17b9c
SLOT_TIP_ACCOUNT=6rYLG55Q9RpsPGvqdPNJs4z5WTxJVatMB8zV3WJhs5EK
NOZOMI_TIP_ACCOUNT=nozWNju6dY353eMkMqURqwQEoM3SFgEKC6psLCSfUne

# Trading configuration
# ⚠️ IMPORTANT: Set exactly ONE of BUY_AMOUNT or BUY_AMOUNT_PERCENTAGE (not both, not neither)
BUY_AMOUNT=0.004                        # Option 1: Fixed buy amount (SOL) for every trade
# BUY_AMOUNT_PERCENTAGE=0.5             # Option 2: Buy as percentage of target's amount (0.5 = 50%, 1.0 = 100%)

MIN_AMOUNT=0.0005                       # REQUIRED: Minimum buy amount (SOL) - safety floor
MAX_AMOUNT=0.5                          # REQUIRED: Maximum buy amount (SOL) - safety ceiling
LIMIT_BALANCE=0.02

# Fees & prioritization (lamports)
PRIORITIZATION_FEE_LAMPORTS=100005
BUY_PRIORITIZATION_FEE_LAMPORTS=20001
SELL_PRIORITIZATION_FEE_LAMPORTS=20001
SELL_ALL_PRIORITIZATION_FEE_LAMPORTS=21001
JITO_TIP_LAMPORTS=20000
NOZOMI_TIP_LAMPORTS=1010001
SLOT_TIP_LAMPORTS=110001

# Slippage (basis points)
SLIPPAGE_BPS=5000
SLIPPAGE_BPS_PERCENTAGE=80
BUY_SLIPPAGE_BPS_PERCENTAGE=2000
SELL_SLIPPAGE_BPS_PERCENTAGE=8000

# Operational settings
MAX_RETRIES=3
RETRY_DELAY=200                       # milliseconds
TRANSACTION_TIMEOUT=20000
WALLET_COUNT_WINDOW=20000
LOW_WALLET_THRESHOLD=1

# Copy / sell settings
ENABLE_COPY_SELL=true
COPY_SELL_MODE=full                   # percentage | full
DIRECT_ADDED_PUMPSWAP=false
# SKIP_STARTUP_CLEANUP=true           # Uncomment to keep existing tokens on startup (default: sells all)

# Buy filter settings (token validation)
MIN_HOLDERS=10                        # minimum number of holders
MAX_HOLDERS=10000                     # maximum number of holders
MAX_TOP10_PERCENTAGE=30               # max percentage held by top 10 holders
MIN_LIQUIDITY=1                       # minimum liquidity in SOL
MAX_LIQUIDITY=10000                   # maximum liquidity in SOL

# DO NOT COMMIT your private keys or any real secret values to source control.
# Add .env to .gitignore and use environment variables or a secrets manager in production.
